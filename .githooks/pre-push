#!/bin/sh
# push 전에 빌드와 공개 금지 문구 검사를 먼저 돌린다. 실패하면 push 자체를 막아 배포 사이트를 지킨다.
# 금지 문구 목록은 저장소에 올리지 않는 .private/forbidden.txt 에 둔다 (팀 내부 공유).
set -e
echo "[pre-push] 빌드 확인"
npm run build --silent >/dev/null
test -f dist/index.html
grep -q 'src="/assets/index-' dist/index.html
if [ -f .private/forbidden.txt ]; then
  if grep -r -l -i -E -f .private/forbidden.txt dist >/dev/null; then
    echo "[pre-push] 공개 금지 문구 발견, push 중단"; exit 1
  fi
else
  echo "[pre-push] .private/forbidden.txt 없음: 문구 검사는 건너뜀 (배포 단계에서 다시 검사)"
fi
echo "[pre-push] 통과"
